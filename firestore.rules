rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidUser(data) {
      return data.name is string && data.name.size() > 0 &&
             data.username is string && data.username.size() >= 1 &&
             data.role in ['Student', 'Teacher', 'Admin'] &&
             ((('passwordHash' in data) && data.passwordHash is string && data.passwordHash.size() >= 1) ||
              (('password' in data) && data.password is string && data.password.size() >= 1));
    }

    function isValidQuestion(data) {
      return data.id is string && data.id.size() > 0 &&
             data.exam in ['NAFS', 'GAT', 'SAT'] &&
             data.section is string &&
             data.skill is string &&
             data.prompt is string &&
             data.options is list && data.options.size() >= 2 &&
             ((('answer' in data) && (data.answer is int || data.answer is number) && data.answer >= 0) || (('correct' in data) && (data.correct is int || data.correct is number) && data.correct >= 0));
    }

    function isValidSettings(data) {
      return data.appName is string &&
             data.loginTitle is string &&
             data.loginHeadline is string;
    }

    function isValidAttempt(data) {
      return data.id is string &&
             data.username is string &&
             data.exam in ['NAFS', 'GAT', 'SAT'] &&
             data.score is number;
    }

    // User accounts collection
    match /users/{username} {
      allow read: if true;
      allow create, update: if isValidUser(request.resource.data);
      allow delete: if true;
    }

    // Question bank collection
    match /questions/{questionId} {
      allow read: if true;
      allow create, update: if isValidQuestion(request.resource.data);
      allow delete: if true;
    }

    // Settings collection
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Attempts collection
    match /attempts/{attemptId} {
      allow read: if true;
      allow create: if isValidAttempt(request.resource.data);
      allow update, delete: if true;
    }

    // User study profiles collection
    match /profiles/{username} {
      allow read, write: if true;
    }

    // Cloud Backups and Data Protection collection
    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Test connectivity document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
